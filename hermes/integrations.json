{
  "note": "Community edition: every integration is not-wired. No connector code and no credentials ship with this repo.",
  "toolCatalog": {
    "files:read": {
      "label": "Read workspace files",
      "offline": true,
      "note": "The workspace is the organization knowledge base."
    },
    "files:write": {
      "label": "Write workspace files",
      "offline": true,
      "note": "Everything except the read-only organization brain."
    },
    "terminal": {
      "label": "Shell in the workspace",
      "offline": true,
      "note": "Search, move and transform knowledge files."
    },
    "memory": {
      "label": "Profile memory",
      "offline": true,
      "note": "Durable per-profile MEMORY.md across sessions."
    },
    "skills": {
      "label": "Packaged skills",
      "offline": true,
      "note": "The procedures shipped in this profile's skills/ folder."
    },
    "web-search": {
      "label": "Web search",
      "offline": false,
      "note": "Requires a configured model provider with search."
    },
    "browser": {
      "label": "Browser / page fetch",
      "offline": false,
      "note": "Requires a configured model provider."
    },
    "image-generation": {
      "label": "Image generation",
      "offline": false,
      "note": "Requires a provider and IMAGE_API_KEY."
    },
    "code-execution": {
      "label": "Code execution",
      "offline": false,
      "note": "For data work and report generation."
    },
    "delegate": {
      "label": "Delegate to subagents",
      "offline": false,
      "note": "Orchestrators only — bounded, non-recursive workers."
    }
  },
