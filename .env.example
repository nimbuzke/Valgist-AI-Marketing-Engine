# AI Marketing Engine — environment
# Copy to `.env` next to docker-compose.yml. Everything here is optional except the
# model key; the engine boots and the whole knowledge/work-order/review layer works
# without any of it.

# ── Model ────────────────────────────────────────────────────────────────────
# The only credential the engine actually uses. Without it the containers still run
# and the Admin Dashboard is fully functional; the chat profiles just can't think.
ANTHROPIC_API_KEY=

# Default model written into each profile's config.yaml on first sync.
HERMES_MODEL=claude-opus-5

# ── Admin dashboard ──────────────────────────────────────────────────────────
# The dashboard is the only thing that can write the read-only organization brain.
# Leave empty on a private machine; set it before exposing port 8321 anywhere else.
# With a token set, open the dashboard once as http://localhost:8321/?token=YOUR_TOKEN
HERMES_ADMIN_TOKEN=

# ── Chat front end ───────────────────────────────────────────────────────────
# Name shown in the browser tab, on the login page and in the sidebar wordmark.
# This is the default for the WebUI's `bot_name` setting; renaming the assistant
# from the WebUI's own settings overrides it and is left alone by the sync.
HERMES_WEBUI_BOT_NAME=Valgist Marketing AI Engine

# Login password for the chat front end. Empty = no login. The WebUI holds your
# provider API key and can edit the workspace — set this before exposing port 8787.
HERMES_WEBUI_PASSWORD=

# ── Serving your team (beyond this machine) ──────────────────────────────────
# Both apps publish on 127.0.0.1 only. Change these to 0.0.0.0 to serve your LAN —
# and set HERMES_ADMIN_TOKEN and HERMES_WEBUI_PASSWORD first, in that order.
# Note the chat front end is architecturally single-user: share the dashboard
# freely, but take turns on :8787.
HERMES_ADMIN_BIND=127.0.0.1
HERMES_WEBUI_BIND=127.0.0.1

# Scoped secret that lets the Marketing Director's promote-to-brain skill call the
# admin API from the WebUI container. Only needed once HERMES_ADMIN_TOKEN is set.
HERMES_PROMOTE_TOKEN=

# ── Guardrails ───────────────────────────────────────────────────────────────
# Set to 1 to enforce the pre-publish compliance gate as a blocking hook in every
# profile: writing a file marked `status: publish-ready` without a linked compliance
# report containing a PASS is refused at the tool level. Off by default so the
# out-of-the-box chat experience is unchanged. See hermes/hooks/README.md.
HERMES_ENFORCE_COMPLIANCE_HOOK=

# ── Integrations ─────────────────────────────────────────────────────────────
# NONE of these are wired. The community edition ships no connector code, so setting
# one changes nothing on its own — the variables are passed through to the runtime so
# that adding an MCP server later is a config change rather than a rebuild.
#
# Profiles are explicitly instructed never to present platform data as fact while an
# integration is unwired. They ask you for an export instead, work from that file, and
# mark everything else [AWAITING DATA]. See hermes/integrations.json for which profile
# declares which system.

GA4_PROPERTY_ID=
GOOGLE_ADS_API_KEY=
BING_ADS_API_KEY=
META_ADS_TOKEN=
LINKEDIN_ADS_TOKEN=
TIKTOK_ADS_TOKEN=
AMAZON_ADS_API_KEY=
CRM_API_KEY=
ESP_API_KEY=
N8N_API_URL=
N8N_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SHOPIFY_API_KEY=
SEO_TOOL_API_KEY=
REVIEW_PLATFORM_API_KEY=
AB_TESTING_TOOL_API_KEY=
WEBINAR_PLATFORM_API_KEY=
SOCIAL_SCHEDULER_API_KEY=
AFFILIATE_PLATFORM_API_KEY=
INTENT_DATA_API_KEY=
HOSTING_DEPLOY_TOKEN=
IMAGE_API_KEY=

# ── pgvector (existing postiz-postgres container, host port 5433) ──────────
# The valgist database and valgist user were created in the postiz-postgres
# container which already runs pgvector (extension version 0.8.7).
# To use vector features: set HERMES_EMBEDDING_PROVIDER=openai (or deterministic)
# and provide OPENAI_API_KEY for real semantic embeddings.
HERMES_PGVECTOR_HOST=host.docker.internal
HERMES_PGVECTOR_PORT=5433
HERMES_PGVECTOR_DB=valgist
HERMES_PGVECTOR_USER=valgist
HERMES_PGVECTOR_PASSWORD=valgist
HERMES_EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
